# grits.env -- resource paths for the GRITS run-sample scripts.
#
# Source this file (the scripts do it for you). Every value can be overridden by exporting the variable
# before running a script, or by copying this file and pointing GRITS_ENV at the copy:
#     cp grits.env ~/my_grits.env && $EDITOR ~/my_grits.env && export GRITS_ENV=~/my_grits.env
#
# Required: GRITS_WORKDIR (working directory holding the checkpoint, lift and panel), GRITS_REFMAP_ROOT
# (directory holding rope_bwt_index_v2/) and GRITS_PY or GRITS_PYTHON_ENV. The other values default to
# locations under those; see references/inputs.md for what each one is and how to build it.

W=${GRITS_WORKDIR:?set GRITS_WORKDIR to the GRITS working directory}

# ropebwt3 with the promoted refmap options (maize-genetics/ropebwt3-phg, branch grits-pipeline or later)
: "${GRITS_ROPEBWT3:=$W/scratch/editmatch/bin/ropebwt3_em_1869360}"
# 25-founder pangenome FM-index (.fmd plus .fmd.ssa and .fmd.len.gz next to it); contigs named <Founder>_chrN
: "${GRITS_INDEX:=${GRITS_REFMAP_ROOT:?set GRITS_REFMAP_ROOT or GRITS_INDEX}/rope_bwt_index_v2/maizeFastaIndex_SampleContig_v2.fmd}"
# lift built from that index with: ropebwt3 lift --ref-prefix=B73 -k 50 -s 200 (k50 is required by the PLACED fix)
: "${GRITS_LIFT:=$W/scratch/placedfix/k50_s200.lift}"
# promoted model checkpoint (GRITSCRFDiploidIndel, trained for exactly these 25 founders)
: "${GRITS_CKPT:=$W/indel_baseline/checkpoints/v6cfullfe-stage2B/last.ckpt}"
# python with torch + pytorch_lightning + numpy/pandas (the repo's pixi env works); GRITS_LD is prepended to
# LD_LIBRARY_PATH (needed by this lab's env, whose scipy wants the env's newer libstdc++)
: "${GRITS_PY:=${GRITS_PYTHON_ENV:?set GRITS_PY or GRITS_PYTHON_ENV}/bin/python}"
: "${GRITS_LD:=${GRITS_PYTHON_ENV:+$GRITS_PYTHON_ENV/lib}}"

# Optional, only for VCF output (bed_to_vcf.sh)
: "${GRITS_PANEL_VCF:=$W/data/maize_v2_rebuild/panel/panel_25founders_v2.vcf}"
: "${GRITS_BED2VCF:=sample}"   # BedToVcf CLI ("sample bed-to-vcf"); default: on PATH
: "${GRITS_JAVA_HOME_BIN:=/programs/jdk-21.0.1/bin}"
: "${GRITS_HTSLIB_BIN:=/programs/bcftools-1.20/bin:/programs/htslib-1.20/bin}"

export GRITS_ROPEBWT3 GRITS_INDEX GRITS_LIFT GRITS_CKPT GRITS_PY GRITS_LD \
       GRITS_PANEL_VCF GRITS_BED2VCF GRITS_JAVA_HOME_BIN GRITS_HTSLIB_BIN
