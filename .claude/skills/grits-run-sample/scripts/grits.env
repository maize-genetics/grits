# grits.env -- resource paths for the GRITS run-sample scripts.
#
# There are no built-in paths: every resource must be set by the user, either by exporting the variables
# before running a script, or by copying this file, filling in the values and pointing GRITS_ENV at the copy:
#     cp grits.env ~/my_grits.env && $EDITOR ~/my_grits.env && export GRITS_ENV=~/my_grits.env
# Values already exported win over anything written below. check_setup.sh lists any that are missing;
# references/inputs.md says what each one is and how to build or obtain it.

# Required
# ropebwt3 with the promoted refmap options (maize-genetics/ropebwt3-phg, branch develop)
: "${GRITS_ROPEBWT3:=}"
# 25-founder pangenome FM-index (.fmd, with .fmd.ssa and .fmd.len.gz next to it); contigs named <Founder>_chrN
: "${GRITS_INDEX:=}"
# lift built from that index with: ropebwt3 lift --ref-prefix=B73 -k 50 -s 200 (k50 is required by the PLACED fix)
: "${GRITS_LIFT:=}"
# promoted model checkpoint (GRITSCRFDiploidIndel v6cfullfe-stage2B, trained on the 25-founder maize panel). A
# panel with fewer assemblies is padded up to the checkpoint's founder count at decode; other species are experimental.
: "${GRITS_CKPT:=}"
# python with torch + pytorch_lightning + numpy/pandas: set GRITS_PY to the binary, or GRITS_PYTHON_ENV to an
# environment directory (its bin/python is used and its lib/ is put on LD_LIBRARY_PATH via GRITS_LD)
: "${GRITS_PY:=${GRITS_PYTHON_ENV:+$GRITS_PYTHON_ENV/bin/python}}"
: "${GRITS_LD:=${GRITS_PYTHON_ENV:+$GRITS_PYTHON_ENV/lib}}"
# name of the reference assembly in the index (contigs are named <assembly>_<contig>); B73 for the maize panel
: "${GRITS_REF_PREFIX:=B73}"

# Optional, only for VCF output (bed_to_vcf.sh)
# genotype VCF of the panel founders, same assemblies and names as the index
: "${GRITS_PANEL_VCF:=}"
# comma-separated chromosomes kept in the VCF; empty keeps every called contig. Default: chr1-chr10 for the
# maize panel (reference B73), every contig otherwise
if [ -z "${GRITS_VCF_CHROMS+x}" ]; then
  [ "$GRITS_REF_PREFIX" = B73 ] && GRITS_VCF_CHROMS=chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10 || GRITS_VCF_CHROMS=
fi
: "${GRITS_BED2VCF:=sample}"   # BedToVcf CLI ("sample bed-to-vcf"); default: on PATH
# java 21 and bcftools/bgzip/tabix are taken from PATH; set these only to put other install directories first
: "${GRITS_JAVA_HOME_BIN:=}"   # e.g. /opt/jdk-21/bin
: "${GRITS_HTSLIB_BIN:=}"      # e.g. /opt/bcftools/bin:/opt/htslib/bin

export GRITS_ROPEBWT3 GRITS_INDEX GRITS_LIFT GRITS_REF_PREFIX GRITS_CKPT GRITS_PY GRITS_LD \
       GRITS_PANEL_VCF GRITS_VCF_CHROMS GRITS_BED2VCF GRITS_JAVA_HOME_BIN GRITS_HTSLIB_BIN
